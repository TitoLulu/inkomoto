{
  "title": "WB Loans Pipeline Health",
  "uid": "kiva-pipeline",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Pipeline Last Run Status",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "pipeline_last_run_status{job=\"wb_pipeline\"}",
          "legendFormat": "Status",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"options": {"0": {"text": "FAILED", "color": "red"}, "1": {"text": "OK", "color": "green"}}, "type": "value"}
          ],
          "thresholds": {
            "steps": [{"color": "red", "value": 0}, {"color": "green", "value": 1}]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Loans Ingested (last run)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [
        {
          "expr": "wb_loans_ingested_count{job=\"wb_ingestion\"}",
          "legendFormat": "Loans",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Ingestion Duration (seconds)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "wb_ingestion_duration_seconds{job=\"wb_ingestion\"}",
          "legendFormat": "Duration",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Ingestion Errors",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [
        {
          "expr": "wb_ingestion_errors_total{job=\"wb_ingestion\"}",
          "legendFormat": "Errors",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "ClickHouse Inserted Rows (rate)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {
          "expr": "rate(ClickHouseProfileEvents_InsertedRows[5m])",
          "legendFormat": "Rows/s"
        }
      ]
    },
    {
      "id": 6,
      "title": "ClickHouse Query Duration (avg)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {
          "expr": "rate(ClickHouseProfileEvents_QueryTimeMicroseconds[5m]) / rate(ClickHouseProfileEvents_Query[5m]) / 1e6",
          "legendFormat": "avg latency (s)"
        }
      ]
    },
    {
      "id": 7,
      "title": "Last Pipeline Run Timestamp",
      "type": "stat",
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 12},
      "targets": [
        {
          "expr": "pipeline_last_run_timestamp{job=\"wb_pipeline\"}",
          "legendFormat": "Last Run",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "dateTimeAsIso"}
      }
    }
  ]
}
